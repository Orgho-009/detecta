# ==============================================================================
# Detecta — Git Ignore Configuration
# ==============================================================================

# --- Python Virtual Environments ---
.venv/
venv/
ENV/
env/
*.env

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
.pytest_cache/

# --- PlatformIO & Embedded Firmware Build Artifacts ---
.pio/
firmware/**/.pio/
firmware/**/.vscode/
.gcc-flags.json
.clang_complete

# --- Chromium / Browser Automation Temporary Profiles ---
edge_profile/
edge_temp/
detecta_edge_*/

# --- Temporary Test Outputs & Disposables ---
test*.pdf
test*.html
test_*.py
inspect_pdf.py

# --- Surveillance Alert Backups & Telemetry Captures ---
backups/*.jpg
database/*.db-journal

# --- Checkpoint Archives & Deep Weights ---
checkpoints/*.zip
checkpoints/**/*.pt

# --- Heavy Model Weights & Experiments (>25MB) ---
weights/
*.onnx
rtdetr*.pt
yolov8*.pt

# --- Media & Asset Whitelisting ---
# Ignore generic root scratch images, but preserve documentation & branding assets
*.jpg
*.png
!logo.png
!logo.ico
!web_dashboard/static/**
!docs/assets/**

# --- PyInstaller & Executable Build Artifacts ---
build/
dist/

# --- Operating System & Editor Metadata ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.idea/
.vscode/
*.swp
*.bak
