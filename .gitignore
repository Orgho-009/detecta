# ==============================================================================
# Detecta — Git Ignore Configuration (Enterprise & Privacy Protected)
# ==============================================================================

# --- Private Hardware Credentials & Wi-Fi Secrets ---
# Keeps your home/office Wi-Fi password and device secrets confidential
secrets.h
firmware/**/secrets.h
*.env
*.env.*
*.key
*.token
*.pem

# --- Local Dashboard Runtime Configuration ---
# Prevents exposing personal camera IP addresses, SSIDs, and local network setups
web_dashboard/config.json
checkpoints/**/config.json

# --- Personal Biometric Data (Face Embeddings Database) ---
# Facial recognition vectors are sensitive personal biometrics (PII)
*.pkl
**/known_faces.pkl

# --- Personal Academic Exam / Viva Defense Cheat Sheets & Notes ---
# Keeps private presentation notes and oral defense Q&A strictly confidential on your local PC
*VIVA_AND_DEFENSE_SCRIPT*
*viva_script*
*viva*
scripts/*viva*
scripts/compile_compact_pdf.py
docs/private/
private/

# --- Surveillance Alert Backups, Captures & Local Telemetry Databases ---
backups/
database/*.db
database/*.sqlite
database/*.sqlite3
database/*.db-journal
database/*.json
!database/.gitkeep

# --- Python Virtual Environments ---
.venv/
venv/
ENV/
env/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
.pytest_cache/

# --- PlatformIO & Embedded Firmware Build Artifacts ---
.pio/
firmware/**/.pio/
firmware/**/.vscode/
.gcc-flags.json
.clang_complete

# --- Chromium / Browser Automation Temporary Profiles ---
edge_profile/
edge_temp/
detecta_edge_*/

# --- Temporary Test Outputs & Disposables ---
test*.pdf
test*.html
test_*.py
inspect_pdf.py

# --- Checkpoint Archives & Deep Weights ---
checkpoints/*.zip
checkpoints/**/*.pt

# --- Heavy Model Weights & Experiments (>25MB) ---
weights/
*.onnx
rtdetr*.pt
yolov8*.pt

# --- Media & Asset Whitelisting ---
# Ignore generic root scratch images, but preserve documentation & branding assets
*.jpg
*.png
!logo.png
!logo.ico
!web_dashboard/static/**
!docs/assets/*.jpg
!docs/assets/*.png
!docs/assets/*.ico
!docs/assets/*.svg

# --- PyInstaller & Executable Build Artifacts ---
build/
dist/

# --- Operating System & Editor Metadata ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.idea/
.vscode/
*.swp
*.bak
